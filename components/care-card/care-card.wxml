<view class="care-card" bindtap="onTap" wx:if="{{record}}">
  <!-- Left accent stripe -->
  <view class="accent-stripe" style="background: {{cat.color}};"></view>

  <!-- Content -->
  <view class="card-content">
    <!-- Left: emoji + summary -->
    <view class="card-left">
      <view class="card-emoji" style="background: {{cat.bgColor}};">{{cat.emoji}}</view>
      <view class="card-info">
        <text class="card-label">{{cat.label}}</text>
        <text class="card-summary">{{summary}}</text>
        <text class="card-creator" wx:if="{{record.creatorName}}">{{record.creatorName}}</text>
      </view>
    </view>
    <!-- Right: time + optional pending-sync dot -->
    <view class="card-right">
      <text class="card-time">{{timeLabel}}</text>
      <text class="card-pending-dot" wx:if="{{pending}}">☁️</text>
    </view>
  </view>
</view>
