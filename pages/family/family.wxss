.family-page {
  height: 100vh;
  background: #FFF9F9;
}

/* Baby card */
.baby-card {
  background: linear-gradient(135deg, #FF8FAB, #FFB5C8);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.baby-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.30);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.baby-avatar-emoji { font-size: 56rpx; }

.baby-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.baby-age {
  font-size: 26rpx;
  color: rgba(255,255,255,0.90);
  display: block;
  margin-top: 4rpx;
}

.baby-birth {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-top: 2rpx;
}

/* Section card */
.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(255,143,171,0.08);
}

.section-label {
  font-size: 22rpx;
  color: #AAAAAA;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* No cloud state */
.no-cloud-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.no-cloud-emoji { font-size: 44rpx; margin-right: 20rpx; }
.no-cloud-title { font-size: 28rpx; font-weight: 600; color: #3D3D3D; display: block; }
.no-cloud-sub   { font-size: 22rpx; color: #AAAAAA; display: block; margin-top: 4rpx; }

/* Invite code */
.invite-code-box {
  background: #FFF0F5;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  border: 2rpx dashed #FF8FAB;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 900;
  color: #FF8FAB;
  letter-spacing: 16rpx;
  display: block;
}

.copy-hint {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 8rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.6;
  display: block;
}

.refresh-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

.refresh-text {
  font-size: 26rpx;
  color: #888888;
}

/* Members */
.member-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.member-row:last-child { border-bottom: none; }

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFD6E3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.member-avatar-text {
  font-size: 28rpx;
  color: #FF8FAB;
  font-weight: 700;
}

.member-info { flex: 1; }

.member-name  { font-size: 28rpx; color: #3D3D3D; font-weight: 600; display: block; }
.member-join  { font-size: 22rpx; color: #AAAAAA; display: block; margin-top: 4rpx; }

.member-role {
  font-size: 22rpx;
  color: #FF8FAB;
  background: #FFF0F5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* Settings */
.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.setting-label { font-size: 28rpx; color: #3D3D3D; font-weight: 500; }

.setting-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.setting-value { font-size: 28rpx; color: #888888; margin-right: 8rpx; }
.setting-arrow { font-size: 32rpx; color: #CCCCCC; }

/* Leave */
.leave-row { display: flex; align-items: center; justify-content: center; padding: 8rpx 0; }
.leave-text { font-size: 28rpx; color: #FF4D4F; }

.bottom-spacer { height: 60rpx; }
