@import '/app.wxss';

.form-page { height: 100vh; background: #FFF9F9; }
.form-hero { padding: 40rpx 32rpx 32rpx; display: flex; flex-direction: column; align-items: center; }
.form-hero-emoji { font-size: 80rpx; margin-bottom: 12rpx; }
.form-hero-title { font-size: 32rpx; font-weight: 700; color: #3D3D3D; }
.form-hero-sub { font-size: 24rpx; color: #7D6000; margin-top: 8rpx; }
.form-body { padding: 24rpx 24rpx 60rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(255,215,0,0.12); }
.card-section-label { font-size: 24rpx; color: #888888; display: block; margin-bottom: 16rpx; font-weight: 500; }
.form-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.form-label { font-size: 28rpx; color: #3D3D3D; font-weight: 500; }
.picker-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; flex: 1; margin-left: 16rpx; }
.picker-value { font-size: 28rpx; color: #3D3D3D; }
.picker-arrow { font-size: 32rpx; color: #CCCCCC; }
.form-input { width: 100%; height: 88rpx; background: #F8F8F8; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; color: #3D3D3D; border: 2rpx solid #F0F0F0; margin-bottom: 20rpx; }
.form-textarea { width: 100%; min-height: 120rpx; background: #F8F8F8; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; color: #3D3D3D; border: 2rpx solid #F0F0F0; line-height: 1.6; }

/* Suggestions */
.suggestion-label { font-size: 22rpx; color: #AAAAAA; display: block; margin-bottom: 12rpx; }
.suggestions-row { display: flex; flex-direction: row; white-space: nowrap; }
.suggestion-chip {
  display: inline-flex; align-items: center; padding: 10rpx 20rpx;
  background: #F5F5F5; border-radius: 999rpx;
  margin-right: 12rpx; border: 2rpx solid #EEEEEE;
}
.suggestion-chip-active { background: #FFF9E0; border-color: #FFD700; }
.suggestion-text { font-size: 24rpx; color: #555555; white-space: nowrap; }
.suggestion-chip-active .suggestion-text { color: #B8860B; font-weight: 600; }

/* Photo grid */
.photo-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-remove-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 3rpx dashed #DDDDDD;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #CCCCCC;
  line-height: 1;
  margin-bottom: 8rpx;
}

.photo-add-text {
  font-size: 22rpx;
  color: #BBBBBB;
}

/* Save button */
.save-btn { margin-top: 12rpx; background: #FFD700; color: #7D6000; border-radius: 999rpx; height: 96rpx; font-size: 32rpx; font-weight: 700; border: none; letter-spacing: 4rpx; width: 100%; }
.save-btn::after { border: none; }
.save-btn[disabled] { opacity: 0.6; }
