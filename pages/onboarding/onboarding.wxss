.ob-page {
  min-height: 100vh;
  background: #FFF9F9;
}

/* Hero */
.ob-hero {
  background: linear-gradient(135deg, #FF8FAB 0%, #FFB5C8 100%);
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ob-hero-sm {
  padding: 48rpx 40rpx 40rpx;
}

.ob-hero-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.ob-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.ob-hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  line-height: 1.6;
}

/* Body */
.ob-body {
  padding: 32rpx 24rpx 60rpx;
}

/* Choice cards */
.ob-choice-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 2rpx 16rpx rgba(255,143,171,0.10);
}

.ob-choice-emoji {
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ob-choice-text {
  flex: 1;
}

.ob-choice-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3D3D;
  display: block;
  margin-bottom: 6rpx;
}

.ob-choice-desc {
  font-size: 24rpx;
  color: #888888;
  display: block;
  line-height: 1.5;
}

.ob-choice-arrow {
  font-size: 44rpx;
  color: #DDDDDD;
  margin-left: 12rpx;
}

/* Form card */
.ob-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255,143,171,0.08);
}

.ob-field-label {
  font-size: 24rpx;
  color: #888888;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.ob-input {
  width: 100%;
  height: 88rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #3D3D3D;
  border: 2rpx solid #F0F0F0;
}

.ob-input-code {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-align: center;
}

.ob-hint {
  font-size: 22rpx;
  color: #BBBBBB;
  display: block;
  margin-top: 12rpx;
}

.ob-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ob-picker-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.ob-picker-val {
  font-size: 28rpx;
  color: #3D3D3D;
  margin-right: 8rpx;
}

.ob-picker-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* Buttons */
.ob-btn-primary {
  width: 100%;
  height: 96rpx;
  background: #FF8FAB;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}
.ob-btn-primary::after { border: none; }
.ob-btn-primary[disabled] { opacity: 0.6; }

.ob-btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #888888;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: 2rpx solid #E0E0E0;
  margin-top: 16rpx;
}
.ob-btn-secondary::after { border: none; }
