.history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFF9F9;
}

/* Header */
.history-header {
  background: linear-gradient(135deg, #FF8FAB 0%, #FFB5C8 100%);
  padding: 40rpx 32rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.history-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.date-picker-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255,255,255,0.25);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.picker-date-text {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-right: 8rpx;
}

.picker-icon {
  font-size: 28rpx;
}

/* Date chip strip */
.date-chips-row {
  display: flex;
  flex-direction: row;
  padding: 16rpx 24rpx;
  white-space: nowrap;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F0F0F0;
  flex-shrink: 0;
}

.chips-spacer {
  width: 8rpx;
  display: inline-block;
}

.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx 8rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
  min-width: 80rpx;
  background: #F5F5F5;
}

.date-chip-selected {
  background: #FFD6E3;
}

.date-chip-text {
  font-size: 24rpx;
  color: #666666;
}

.date-chip-selected .date-chip-text {
  color: #FF8FAB;
  font-weight: 700;
}

.date-chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FF8FAB;
  margin-top: 6rpx;
}

/* Records scroll area */
.records-scroll {
  flex: 1;
}

.records-container {
  padding: 24rpx;
}

.category-group {
  margin-bottom: 24rpx;
}

/* Sync error banner */
.sync-error-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  background: #FFF2E8;
  border: 2rpx solid #FFD1A3;
}
.err-emoji { font-size: 32rpx; margin-right: 12rpx; }
.err-text  { flex: 1; font-size: 26rpx; color: #3D3D3D; }
.err-arrow { font-size: 32rpx; color: #AAAAAA; }

/* Skeleton */
.skeleton-card {
  height: 120rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #F5F5F5 0%, #ECECEC 50%, #F5F5F5 100%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}
@keyframes skeleton-pulse {
  0%   { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* Empty */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #AAAAAA;
}

.bottom-spacer {
  height: 40rpx;
}
