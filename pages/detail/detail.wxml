<view class="detail-page" wx:if="{{record}}">
  <!-- Hero -->
  <view class="detail-hero" style="background: {{cat.bgColor}};">
    <view class="hero-emoji-wrap" style="background: {{cat.color}}40;">
      <text class="hero-emoji">{{cat.emoji}}</text>
    </view>
    <text class="hero-label">{{cat.label}}</text>
    <text class="hero-time">{{dateDisplay}} {{timeDisplay}}</text>
  </view>

  <!-- Fields -->
  <view class="fields-card">
    <view
      class="field-row {{index < fields.length - 1 ? 'field-row-border' : ''}}"
      wx:for="{{fields}}"
      wx:key="label"
    >
      <text class="field-label">{{item.label}}</text>
      <text class="field-value">{{item.value}}</text>
    </view>
  </view>

  <!-- Photos (milestone only) -->
  <view class="photos-card" wx:if="{{photos.length > 0}}">
    <text class="photos-title">📷 照片</text>
    <view class="photos-grid">
      <image
        class="photo-thumb"
        wx:for="{{photos}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        bindtap="onPreviewPhoto"
        data-src="{{item}}"
      />
    </view>
  </view>

  <!-- Videos (milestone only) -->
  <view class="photos-card" wx:if="{{videos.length > 0}}">
    <text class="photos-title">🎬 短视频</text>
    <view class="videos-list">
      <video
        wx:for="{{videos}}"
        wx:key="*this"
        class="video-player"
        src="{{item}}"
        controls="{{true}}"
        show-center-play-btn="{{true}}"
        object-fit="cover"
      ></video>
    </view>
  </view>

  <!-- Logged at -->
  <view class="meta-row">
    <text class="meta-text">记录于 {{createdAtDisplay}}</text>
  </view>

  <!-- Edit + Delete buttons -->
  <view class="action-area">
    <button class="edit-btn" bindtap="onEdit">编辑此记录</button>
    <button class="delete-btn" bindtap="onDelete">删除此记录</button>
  </view>
</view>
