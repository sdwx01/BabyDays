.detail-page {
  min-height: 100vh;
  background: #FFF9F9;
  padding-bottom: 60rpx;
}

/* Hero */
.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 36rpx;
}

.hero-emoji-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.hero-emoji {
  font-size: 60rpx;
}

.hero-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3D3D;
  display: block;
  margin-bottom: 8rpx;
}

.hero-time {
  font-size: 26rpx;
  color: #888888;
  display: block;
}

/* Fields card */
.fields-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 143, 171, 0.08);
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 0;
}

.field-row-border {
  border-bottom: 1rpx solid #F5F5F5;
}

.field-label {
  font-size: 26rpx;
  color: #888888;
  flex-shrink: 0;
  margin-right: 24rpx;
  padding-top: 2rpx;
}

.field-value {
  font-size: 28rpx;
  color: #3D3D3D;
  font-weight: 500;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

/* Photos */
.photos-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 143, 171, 0.08);
}

.photos-title {
  font-size: 26rpx;
  color: #888888;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.photos-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  display: block;
}

/* Meta */
.meta-row {
  padding: 0 28rpx 8rpx;
  text-align: center;
}

.meta-text {
  font-size: 22rpx;
  color: #CCCCCC;
}

/* Delete */
.delete-area {
  padding: 32rpx 24rpx 0;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  background: #FFF5F5;
  color: #FF4D4F;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #FFCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn::after { border: none; }
