<scroll-view scroll-y class="page-container">
  <!-- Hero header -->
  <view class="hero">
    <view class="hero-left">
      <text class="greeting">{{greeting}}，{{babyName}} 👶</text>
      <text class="date-display">{{dateDisplay}}</text>
      <text class="baby-age" wx:if="{{babyAge}}">宝宝 {{babyAge}} 了</text>
    </view>
    <view class="hero-right" bindtap="goToFamily">
      <text class="family-icon">👨‍👩‍👧</text>
      <text class="sync-dot" wx:if="{{isSyncing}}">↻</text>
    </view>
  </view>

  <!-- Sync error banner -->
  <view class="sync-error-banner" wx:if="{{syncError}}" bindtap="onRetrySync">
    <text class="banner-emoji">⚠️</text>
    <text class="banner-text">云端同步失败，点击重试</text>
    <text class="banner-arrow">↻</text>
  </view>

  <!-- Pending sync badge (records waiting to push to cloud) -->
  <view class="pending-banner" wx:if="{{pendingCount > 0}}">
    <text class="banner-emoji">☁️</text>
    <text class="banner-text">{{pendingCount}} 条记录等待同步</text>
  </view>

  <!-- Active state banners -->
  <view class="active-banner sleep-banner" wx:if="{{activeSleep}}" bindtap="goToSleep">
    <text class="banner-emoji">😴</text>
    <text class="banner-text">睡眠进行中，点击结束睡眠</text>
    <text class="banner-arrow">›</text>
  </view>
  <view class="active-banner outing-banner" wx:if="{{activeOuting}}" bindtap="goToOuting">
    <text class="banner-emoji">🌳</text>
    <text class="banner-text">外出进行中，点击结束外出</text>
    <text class="banner-arrow">›</text>
  </view>

  <!-- Summary chips -->
  <scroll-view scroll-x class="chips-row" enhanced="{{true}}" show-scrollbar="{{false}}">
    <summary-chip
      wx:for="{{chips}}"
      wx:key="label"
      emoji="{{item.emoji}}"
      label="{{item.label}}"
      value="{{item.value}}"
      subtext="{{item.subtext}}"
      color="{{item.color}}"
      bg-color="{{item.bgColor}}"
    />
    <view class="chips-end-spacer"></view>
  </scroll-view>

  <!-- Loading skeleton (first-run only) -->
  <view class="section-wrapper" wx:if="{{isLoading && isEmpty}}">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- Milestone recap entry -->
  <view class="milestone-entry" bindtap="goToMilestones">
    <view class="milestone-entry-left">
      <text class="milestone-entry-emoji">⭐</text>
      <view class="milestone-entry-text">
        <text class="milestone-entry-title">成长相册</text>
        <text class="milestone-entry-sub">回顾宝宝的每一个第一次</text>
      </view>
    </view>
    <text class="milestone-entry-arrow">›</text>
  </view>

  <!-- Today's timeline -->
  <view class="section-wrapper" wx:if="{{!isEmpty}}">
    <section-header emoji="📋" title="今日记录" color="#FF8FAB" />
    <care-card
      wx:for="{{todayRecords}}"
      wx:key="id"
      record="{{item}}"
      bind:cardtap="onCardTap"
    />
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{isEmpty && !isLoading}}">
    <text class="empty-state-emoji">🌸</text>
    <text class="empty-state-text">今日暂无记录</text>
    <text class="empty-state-sub">点击下方「记录」标签，开始记录宝宝的每一刻</text>
    <view class="empty-go-log" bindtap="onLogTap">
      <text class="empty-go-log-text">去记录 →</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</scroll-view>

<!-- Floating action button -->
<view class="log-fab" bindtap="onLogTap" wx:if="{{!isEmpty}}">
  <text class="log-fab-text">＋ 记录</text>
</view>
