.page-container {
  height: 100vh;
  background: #FFF9F9;
}

/* Hero */
.hero {
  background: linear-gradient(135deg, #FF8FAB 0%, #FFB5C8 100%);
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.date-display {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
}

.baby-age {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-top: 4rpx;
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.family-icon {
  font-size: 44rpx;
}

.sync-dot {
  font-size: 22rpx;
  color: rgba(255,255,255,0.80);
  margin-top: 4rpx;
}

/* Active banners */
.active-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
}

.sleep-banner {
  background: #E8F9FF;
  border: 2rpx solid #B5F0FF;
}

.outing-banner {
  background: #EFFFEF;
  border: 2rpx solid #B5FFD5;
}

.banner-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #3D3D3D;
}

.banner-arrow {
  font-size: 36rpx;
  color: #AAAAAA;
}

/* Chips */
.chips-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 24rpx 24rpx 8rpx;
}

.chips-end-spacer {
  width: 8rpx;
  display: inline-block;
}

/* Section */
.section-wrapper {
  padding: 24rpx 24rpx 0;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 60rpx;
}

.empty-state-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #AAAAAA;
  margin-bottom: 12rpx;
}

.empty-state-sub {
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-go-log {
  background: #FF8FAB;
  border-radius: 999rpx;
  padding: 18rpx 48rpx;
}

.empty-go-log-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* Floating action button */
.log-fab {
  position: fixed;
  bottom: 128rpx;
  right: 32rpx;
  background: #FF8FAB;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 143, 171, 0.45);
  z-index: 100;
}

.log-fab-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.bottom-spacer {
  height: 40rpx;
}
